<?php $x = static fn ($v): string => \Pdir\MaklermodulBundle\Util\Helper::escapeXml($v); ?>
<?= '<?' ?>xml version="1.0" encoding="UTF-8"?>
<openimmo_feedback>
    <version>1.2.5</version>
    <sender>
        <?php if($this->name) :?><name><?= $x($this->name) ?></name><?php endif; ?>
        <?php if($this->openimmo_anid) :?><openimmo_anid><?= $x($this->openimmo_anid) ?></openimmo_anid><?php endif; ?>
        <?php if($this->datum) :?><datum><?= $x($this->datum) ?></datum><?php endif; ?>
        <?php if($this->makler_id) :?><makler_id><?= $x($this->makler_id) ?></makler_id><?php endif; ?>
        <?php if($this->regi_id) :?><regi_id><?= $x($this->regi_id) ?></regi_id><?php endif; ?>
    </sender>
    <objekt>
        <?php if($this->portal_unique_id) :?><portal_unique_id><?= $x($this->portal_unique_id) ?></portal_unique_id><?php endif; ?>
        <?php if($this->portal_obj_id) :?><portal_obj_id><?= $x($this->portal_obj_id) ?></portal_obj_id><?php endif; ?>
        <?php if($this->anbieter_id) :?><anbieter_id><?= $x($this->anbieter_id) ?></anbieter_id><?php endif; ?>
        <oobj_id><?= $x($this->oobj_id) ?></oobj_id>
        <?php if($this->zusatz_refnr) :?><zusatz_refnr><?= $x($this->zusatz_refnr) ?></zusatz_refnr><?php endif; ?>
        <?php if($this->expose_url) :?><expose_url><?= $x($this->expose_url) ?></expose_url><?php endif; ?>
        <?php if($this->vermarktungsart) :?><vermarktungsart><?= $x($this->vermarktungsart) ?></vermarktungsart><?php endif; ?>
        <?php if($this->bezeichnung) :?><bezeichnung><?= $x($this->bezeichnung) ?></bezeichnung><?php endif; ?>
        <?php if($this->etage) :?><etage><?= $x($this->etage) ?></etage><?php endif; ?>
        <?php if($this->whg_nr) :?><whg_nr><?= $x($this->whg_nr) ?></whg_nr><?php endif; ?>
        <?php if($this->strasse) :?><strasse><?= $x($this->strasse) ?></strasse><?php endif; ?>
        <?php if($this->ort) :?><ort><?= $x($this->ort) ?></ort><?php endif; ?>
        <?php if($this->preis) :?><preis><?= $x($this->preis) ?></preis><?php endif; ?>
        <?php if($this->gebot) :?><gebot><?= $x($this->gebot) ?></gebot><?php endif; ?>
        <?php if($this->wae) :?><wae><?= $x($this->wae) ?></wae><?php endif; ?>
        <interessent>
            <?php foreach ($this->fields as $key=>$value): ?>
            <?php if (!preg_match('/^[a-z_]+$/', (string) $key)) continue; ?>
            <?php if($key == 'wunsch'): ?>
            <?php foreach ((array) $value as $val): ?>
            <<?= $key ?>><?= $x($val) ?></<?= $key ?>>
        <?php endforeach; ?>
        <?php continue; endif; ?>
        <<?= $key ?>><?= $x($value) ?></<?= $key ?>>
    <?php endforeach; ?>
    </interessent>
    </objekt>
</openimmo_feedback>