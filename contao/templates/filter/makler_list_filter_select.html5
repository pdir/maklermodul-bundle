<?php $e = static fn ($v): string => \Pdir\MaklermodulBundle\Util\Helper::escape($v); ?>
<?php if(isset($this->filterConfig['groups'])): ?>
  <?php foreach ($this->filterConfig['groups'] as $filter): ?>
  <div class="<?= $e($filter['key']) ?>">
    <label class="header" for="<?= $e($filter['key']) ?>"><?= $e($filter['name']) ?></label>
    <select class="content mm-filter-sel" name="<?= $e($filter['key']) ?>" id="<?= $e($filter['key']) ?>">
      <option value="-1"><?= $GLOBALS['TL_LANG']['MSC']['all'] ?></option>
      <?php foreach ($this->filterConfig['values'][$filter['key']] as $values): ?>
        <option value=".<?= $e($filter['key']) ?>-<?= $e($values['css']) ?>" <?php if(\Contao\Input::get($filter['key']) == $values['css']) echo " selected"; ?>>
          <?= $e($values['name']) ?>
        </option>
      <?php endforeach; ?>
    </select>
  </div>
  <?php endforeach; ?>
<?php endif; ?>