<?php if(count($this->articles) > 1): ?>
    <!-- indexer::stop -->
    <div class="pagination block">
        <p><?= $this->total; ?></p>
        <ul>
            <?php if ($this->first): ?>
                <li class="first"><a href="<?= $this->first['href']; ?>" class="first" title="<?= $this->first['title']; ?>"><?= $this->first['link']; ?></a></li>
            <?php endif; ?>
            <?php if ($this->previous): ?>
                <li class="previous"><a href="<?= $this->previous['href']; ?>" class="previous" title="<?= $this->previous['title']; ?>"><?= $this->previous['link']; ?></a></li>
            <?php endif; ?>
            <?php if ($this->startat): ?>
                <li class="startat"><a href="<?= $this->startat['href']; ?>" class="startat" title="<?= $this->startat['title']; ?>"><?= $this->startat['link']; ?></a></li>
            <?php endif; ?>
            <?php foreach ($this->articles as $article): ?>
                <?php if ($article['isActive']): ?>
                    <li><span class="current"><?= $article['link']; ?></span></li>
                <?php else: ?>
                    <li><a href="<?= $article['href']; ?>" class="link" title="<?= $article['title']; ?>"><?= $article['link']; ?></a></li>
                <?php endif; ?>
            <?php endforeach; ?>
            <?php if ($this->stopat): ?>
                <li class="stopat"><a href="<?= $this->stopat['href']; ?>" class="stopat" title="<?= $this->stopat['title']; ?>"><?= $this->stopat['link']; ?></a></li>
            <?php endif; ?>
            <?php if ($this->next): ?>
                <li class="next"><a href="<?= $this->next['href']; ?>" class="next" title="<?= $this->next['title']; ?>"><?= $this->next['link']; ?></a></li>
            <?php endif; ?>
            <?php if ($this->last): ?>
                <li class="last"><a href="<?= $this->last['href']; ?>" class="last" title="<?= $this->last['title']; ?>"><?= $this->last['link']; ?></a></li>
            <?php endif; ?>
        </ul>
    </div>
    <!-- indexer::continue -->
<?php endif; ?>