<ul class="<?= $this->level; ?>" role="<?= ($this->level == 'level_1') ? 'menubar' : 'menu'; ?>">
    <?php foreach ($this->items as $item): ?>
    <?php if ($maklerItems = \Pdir\MaklermodulBundle\Util\Helper::getSubPages($item)): ?>
    <li<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?>><a href="<?= $item['href']; ?>" title="<?= $item['pageTitle'] ?: $item['title']; ?>"<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?><?php if ($item['accesskey'] != ''): ?> accesskey="<?= $item['accesskey']; ?>"<?php endif; ?><?php if ($item['tabindex']): ?> tabindex="<?= $item['tabindex']; ?>"<?php endif; ?><?php if ($item['nofollow']): ?> rel="nofollow"<?php endif; ?><?= $item['target']; ?> role="menuitem"<?php if (!empty($item['subitems'])): ?> aria-haspopup="true"<?php endif; ?>><?= $item['link']; ?></a>
    <ul class="<?= $this->level++; ?>">
        <?php foreach ($maklerItems as $item): ?>
        <li<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?>><a
            href="<?= $item['href']; ?>"
            title="<?= $item['pageTitle'] ? $item['pageTitle'] : $item['name']; ?>"<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?><?php if ($item['accesskey'] != ''): ?> accesskey="<?= $item['accesskey']; ?>"<?php endif; ?><?php if ($item['tabindex']): ?> tabindex="<?= $item['tabindex']; ?>"<?php endif; ?><?php if ($item['nofollow']): ?> rel="nofollow"<?php endif; ?><?= $item['target']; ?>><?= $item['link']; ?></a><?= $item['subitems']; ?>
        </li>
        <?php endforeach; ?>
    </ul>
    </li>
    <?php else: ?>
    <?php if ($item['isActive']): ?>
    <li class="<?= $item['class']; ?>"><span class="<?= $item['class']; ?>" role="menuitem"<?php if (!empty($item['subitems'])): ?> aria-haspopup="true"<?php endif; ?>><?= $item['link']; ?></span><?= $item['subitems']; ?></li>
    <?php else: ?>
    <li<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?>><a href="<?= $item['href']; ?>" title="<?= $item['pageTitle'] ?: $item['title']; ?>"<?php if ($item['class']): ?> class="<?= $item['class']; ?>"<?php endif; ?><?php if ($item['accesskey'] != ''): ?> accesskey="<?= $item['accesskey']; ?>"<?php endif; ?><?php if ($item['tabindex']): ?> tabindex="<?= $item['tabindex']; ?>"<?php endif; ?><?php if ($item['nofollow']): ?> rel="nofollow"<?php endif; ?><?= $item['target']; ?> role="menuitem"<?php if (!empty($item['subitems'])): ?> aria-haspopup="true"<?php endif; ?>><?php echo $item['link']; ?></a><?php echo $item['subitems']; ?></li>
    <?php endif; ?>
    <?php endif; ?>
    <?php endforeach; ?>
</ul>

