<?php if (!is_object($this->estate)): ?>
  <h1>pdir Maklermodul - Detailansicht</h1>
  <p><?= $GLOBALS['TL_LANG']['makler_modul_mplus']['field_keys']['noestate'] ?></p>
<?php return; endif; ?>

<?php // Übersetzungen
  $yes = $GLOBALS['TL_LANG']['MSC']['yes'];
  $no = $GLOBALS['TL_LANG']['MSC']['no'];

?>

<?php if($this->estate->renderer('freitexte.objekttitel')->asText()->value(true) !== ''): ?>
<div class="estate-detail extended">
  <div class="obj-header">
    <?php $this->estate->renderer('verwaltung_techn.objektnr_extern')->asText()->render(); ?>
    <h1>
      <?php $this->estate->renderer('freitexte.objekttitel')->asText()->value(); ?>
    </h1>
  </div>
  <div class="content">
    <div class="big-img">
      <?php if($this->estate->renderer('anhaenge.anhang.#1.daten.pfad')->asText()->withoutLabel()->value(true)): ?>
        <?php if (preg_match('#^https?://#i', (string) $this->estate->rawValue('anhaenge.anhang.#1.daten.pfad'))): ?>
          <img src="<?= \Pdir\MaklermodulBundle\Util\Helper::escape($this->estate->rawValue('anhaenge.anhang.#1.daten.pfad')) ?>" width="700" height="500">
        <?php else: ?>
          {{<?= $this->detailImageType ?>::<?= Pdir\MaklermodulBundle\Util\Helper::getImageLinkPath() . \Pdir\MaklermodulBundle\Util\Helper::escapeInsertTagParam($this->estate->rawValue('anhaenge.anhang.#1.daten.pfad')); ?>?<?php if($this->detailImageSize): ?>size=<?= $this->detailImageSize ?>&<?php endif; ?>width=<?= $this->detailImageWidth ?>&height=<?= $this->detailImageHeight ?>&alt=<?= \Pdir\MaklermodulBundle\Util\Helper::escapeInsertTagParam($this->estate->rawValue('freitexte.objekttitel')) ?><?php if($this->detailImageMode): ?>&mode=<?= $this->detailImageMode ?><?php endif; ?>}}
        <?php endif; ?>
      <?php else: ?>
        <?php if(strpos($this->placeholderImg, 'files/') !== false): ?>
          {{<?= $this->detailImageType ?>::<?= $this->placeholderImg ?>?<?php if($this->detailImageSize): ?>size=<?= $this->detailImageSize ?>&<?php endif; ?>width=<?= $this->detailImageWidth ?>&height=<?= $this->detailImageHeight ?>&alt=<?= \Pdir\MaklermodulBundle\Util\Helper::escapeInsertTagParam($this->estate->rawValue('freitexte.objekttitel')) ?><?php if($this->detailImageMode): ?>&mode=<?= $this->detailImageMode ?><?php endif; ?>}}
        <?php else: ?>
          <img src="<?= $this->placeholderImg ?>" alt="<?= $GLOBALS['TL_LANG']['MSC']['placeholderImage'] ?> <?= \Pdir\MaklermodulBundle\Util\Helper::escape($this->estate->rawValue('freitexte.objekttitel')) ?>" width="700" height="500">
        <?php endif; ?>
      <?php endif; ?>
    </div>
    <div class="small-pics">
      <?php foreach ($this->estate->attachments()->range(1, 6) as $attachment) : ?>
